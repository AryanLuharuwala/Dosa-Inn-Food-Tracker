{
  "name": "rocky-da-adda-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop launcher for the Rocky Da Adda admin panel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rockydaadda.admin",
    "productName": "Rocky Da Adda Admin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
